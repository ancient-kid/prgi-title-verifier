# =============================================================================
# PRGI Automated Title Verification System - .gitignore
# =============================================================================

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/

# --- Local Databases & Transient Caches ---
# SQLite runtime databases (data/titles.parquet is preserved for speed)
*.sqlite
*.sqlite3
data/*.db
data/app_storage.db

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Logs & Process Temp ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker ---
.docker/
docker-compose.override.yml


# --- Node / Next.js Frontend ---
node_modules/
.next/
out/
build/
.env.local
.env.development.local
.env.test.local
.env.production.local
